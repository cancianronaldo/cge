<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f8f7f4;
  --bg2:#f0ede8;
  --surface:#ffffff;
  --surface2:#f4f2ee;
  --border:#e2ddd7;
  --border2:#ccc8c0;
  --ink:#18170f;
  --ink2:#5c5a52;
  --ink3:#9c9a92;
  --blue:#1847c4;
  --blue-bg:#eef2fd;
  --blue-border:#c4d0f8;
  --green:#146c3a;
  --green-bg:#e8f6ef;
  --green-border:#a8dfc0;
  --amber:#a05c0a;
  --amber-bg:#fef6e8;
  --amber-border:#f8d99a;
  --red:#b01818;
  --red-bg:#fdf0f0;
  --red-border:#f0b4b4;
  --purple:#5b2ca0;
  --purple-bg:#f3effe;
  --purple-border:#cbafe8;
  --teal:#0a6a62;
  --teal-bg:#e8f7f5;
  --teal-border:#9addd7;
  --r:8px;
  --r2:12px;
  --shadow:0 1px 2px rgba(0,0,0,.06),0 1px 4px rgba(0,0,0,.04);
  --shadow2:0 2px 8px rgba(0,0,0,.08),0 1px 3px rgba(0,0,0,.06);
  font-family:'IBM Plex Sans',system-ui,sans-serif;
}
@media(prefers-color-scheme:dark){
  :root{
    --bg:#0f0f0d;--bg2:#17170f;--surface:#1c1c14;--surface2:#232318;
    --border:#2e2e22;--border2:#3e3e30;
    --ink:#f5f4ef;--ink2:#a8a69e;--ink3:#666660;
    --blue:#6b95f5;--blue-bg:#141e3c;--blue-border:#2a3d78;
    --green:#4dbb7a;--green-bg:#0d2419;--green-border:#1a4d30;
    --amber:#e8a030;--amber-bg:#261900;--amber-border:#4d3408;
    --red:#f07070;--red-bg:#260d0d;--red-border:#4d1a1a;
    --purple:#b08cf0;--purple-bg:#180d30;--purple-border:#362060;
    --teal:#4accc4;--teal-bg:#061e1c;--teal-border:#123d3a;
  }
}
body{background:var(--bg);color:var(--ink);min-height:100vh;font-size:14px;line-height:1.6}

/* ─── TOPBAR ─── */
.topbar{
  position:sticky;top:0;z-index:200;
  background:var(--surface);border-bottom:1px solid var(--border);
  padding:0 1.5rem;height:54px;
  display:flex;align-items:center;justify-content:space-between;gap:1rem;
}
.topbar-brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit}
.topbar-logo{
  width:30px;height:30px;border-radius:7px;background:var(--ink);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.topbar-logo svg{display:block}
.topbar-name{font-size:13px;font-weight:600;letter-spacing:.2px}
.topbar-sub{font-size:11px;color:var(--ink3);margin-left:8px;padding-left:8px;border-left:1px solid var(--border2);display:none}
@media(min-width:640px){.topbar-sub{display:block}}
.topbar-right{display:flex;align-items:center;gap:8px}
.topbar-date{font-size:11px;color:var(--ink3);font-family:'IBM Plex Mono',monospace;display:none}
@media(min-width:768px){.topbar-date{display:block}}
.btn-upload{
  padding:6px 14px;border-radius:var(--r);border:1px solid var(--border2);
  background:var(--surface2);color:var(--ink);font-size:12px;font-weight:500;
  cursor:pointer;transition:all .15s;white-space:nowrap;font-family:inherit;
}
.btn-upload:hover{background:var(--bg2);border-color:var(--border2)}
#fileInput{display:none}

/* ─── TABS ─── */
.tabs-wrap{background:var(--surface);border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none}
.tabs-wrap::-webkit-scrollbar{display:none}
.tabs{display:flex;padding:0 1.5rem;gap:0;white-space:nowrap}
.tab{
  padding:11px 16px;font-size:12px;font-weight:500;color:var(--ink2);
  cursor:pointer;border-bottom:2px solid transparent;transition:all .15s;
  user-select:none;
}
.tab:hover{color:var(--ink)}
.tab.on{color:var(--blue);border-bottom-color:var(--blue)}

/* ─── MAIN ─── */
.main{max-width:1320px;margin:0 auto;padding:1.5rem 1.5rem 4rem}

/* ─── SECTION LABEL ─── */
.slabel{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--ink3);margin-bottom:.6rem}

/* ─── KPI GRID ─── */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:1.25rem}
.kpi{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:.9rem 1.1rem;box-shadow:var(--shadow)}
.kpi-label{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--ink3);margin-bottom:4px}
.kpi-value{font-size:26px;font-weight:600;line-height:1;color:var(--ink);font-family:'IBM Plex Mono',monospace}
.kpi-sub{font-size:11px;color:var(--ink2);margin-top:3px}
.kpi.k-blue{border-left:3px solid var(--blue)}
.kpi.k-green{border-left:3px solid var(--green)}
.kpi.k-red{border-left:3px solid var(--red)}
.kpi.k-amber{border-left:3px solid var(--amber)}
.kpi.k-purple{border-left:3px solid var(--purple)}

/* ─── PROGRESS ─── */
.prog-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:1.1rem 1.4rem;box-shadow:var(--shadow);margin-bottom:1.25rem}
.prog-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.6rem}
.prog-title{font-size:13px;font-weight:600}
.prog-pct{font-size:22px;font-weight:600;color:var(--green);font-family:'IBM Plex Mono',monospace}
.prog-track{height:8px;background:var(--surface2);border-radius:99px;overflow:hidden;margin-bottom:.5rem}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--green),#22c55e);border-radius:99px;transition:width .8s cubic-bezier(.16,1,.3,1)}
.prog-legend{display:flex;flex-wrap:wrap;gap:12px;font-size:11px;color:var(--ink2)}
.prog-dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:4px;vertical-align:middle}

/* ─── STATUS CHIPS ─── */
.status-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:1.25rem}
.s-chip{
  background:var(--surface);border:1px solid var(--border);border-radius:99px;
  padding:5px 14px;font-size:12px;display:flex;align-items:center;gap:8px;
  box-shadow:var(--shadow);
}
.s-chip-n{font-weight:600;font-family:'IBM Plex Mono',monospace;color:var(--ink)}
.s-chip-l{color:var(--ink2)}

/* ─── CHARTS GRID ─── */
.charts-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:14px;margin-bottom:1.25rem}
.chart-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:1.1rem 1.4rem;box-shadow:var(--shadow)}
.chart-title{font-size:12px;font-weight:600;color:var(--ink);margin-bottom:1rem}
.chart-wrap{position:relative;width:100%}

/* ─── TIMELINE CARD ─── */
.timeline-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:1.1rem 1.4rem;box-shadow:var(--shadow);margin-bottom:1.25rem}

/* ─── IMPEDIMENTO BLOCK ─── */
.imp-block{background:var(--red-bg);border:1px solid var(--red-border);border-radius:var(--r2);padding:1rem 1.25rem;margin-bottom:1.25rem}
.imp-title{font-size:12px;font-weight:600;color:var(--red);margin-bottom:.5rem;display:flex;align-items:center;gap:6px}
.imp-item{font-size:11.5px;color:var(--red);padding:4px 0 4px .75rem;border-left:2px solid var(--red-border);margin-top:4px;line-height:1.4}

/* ─── TABLE CARD ─── */
.table-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);box-shadow:var(--shadow);overflow:hidden}
.table-head{padding:.9rem 1.25rem;border-bottom:1px solid var(--border);display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;justify-content:space-between}
.table-head-title{font-size:12px;font-weight:600}
.table-controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.search-box{
  padding:6px 12px;border:1px solid var(--border);border-radius:var(--r);
  font-size:12px;background:var(--surface2);color:var(--ink);width:200px;
  font-family:inherit;transition:border-color .15s;
}
.search-box:focus{outline:none;border-color:var(--blue)}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:12px}
th{
  background:var(--surface2);padding:8px 12px;text-align:left;
  font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;
  color:var(--ink2);border-bottom:1px solid var(--border);white-space:nowrap;
  position:sticky;top:0;
}
td{padding:9px 12px;border-bottom:1px solid var(--border);vertical-align:top;line-height:1.4}
tr:last-child td{border-bottom:none}
tr:hover td{background:var(--surface2)}
td.mono{font-family:'IBM Plex Mono',monospace;font-size:11px}

/* ─── BADGES ─── */
.badge{display:inline-block;padding:2px 8px;border-radius:5px;font-size:10px;font-weight:600;white-space:nowrap}
.b-prod{background:var(--green-bg);color:var(--green);border:1px solid var(--green-border)}
.b-open{background:var(--blue-bg);color:var(--blue);border:1px solid var(--blue-border)}
.b-back{background:var(--surface2);color:var(--ink2);border:1px solid var(--border)}
.b-imp{background:var(--red-bg);color:var(--red);border:1px solid var(--red-border)}
.b-hom{background:var(--amber-bg);color:var(--amber);border:1px solid var(--amber-border)}
.b-enc{background:var(--teal-bg);color:var(--teal);border:1px solid var(--teal-border)}
.b-dev{background:var(--purple-bg);color:var(--purple);border:1px solid var(--purple-border)}

/* ─── FALA NOTICE ─── */
.fala-notice{background:var(--blue-bg);border:1px solid var(--blue-border);border-radius:var(--r);padding:.75rem 1rem;font-size:12px;color:var(--blue);margin-bottom:1rem}

/* ─── FOOTER ─── */
.footer{text-align:center;padding:2rem;font-size:11px;color:var(--ink3);border-top:1px solid var(--border);margin-top:2rem}

/* ─── TOAST ─── */
#toast{
  position:fixed;bottom:1.5rem;right:1.5rem;z-index:999;
  padding:10px 18px;border-radius:var(--r);font-size:12px;font-weight:500;
  color:#fff;opacity:0;transition:opacity .3s;pointer-events:none;
}
#toast.show{opacity:1}

/* ─── RESPONSIVE ─── */
@media(max-width:640px){
  .main{padding:1rem 1rem 3rem}
  .topbar{padding:0 1rem}
  .tabs{padding:0 1rem}
  .kpi-value{font-size:22px}
}

/* ─── PRINT ─── */
@media print{
  .topbar,.tabs-wrap,.btn-upload,.table-controls{display:none}
  .main{padding:0}
  .chart-card,.timeline-card,.table-card{break-inside:avoid}
}
</style>
</head>
