// ─── STATE ───
let SHEETS = {};
let current = 'Geral';

// ─── NORMALIZERS ───
function normStatus(s) {
  if (!s) return 'Sem Status';
  const t = String(s).trim().toLowerCase();
  if (t.includes('produ')) return 'Produção';
  if (t.includes('backlog')||t.includes('aberto')) return 'Aberto/Backlog';
  if (t.includes('impedi')||t.includes('impedit')) return 'Impedimento';
  if (t.includes('homolog')) return 'Homologação';
  if (t.includes('encerra')||t.includes('conclu')) return 'Encerrado';
  if (t.includes('desenv')) return 'Desenvolvimento';
  if (t.includes('open')) return 'Open';
  if (t.includes('valida')) return 'Validar';
  return String(s).trim();
}
function normCat(c) {
  if (!c) return null;
  const t = String(c).trim().toLowerCase();
  if (t.includes('melhoria')) return 'Melhoria';
  if (t.includes('corre')) return 'Correção';
  if (t.includes('erro')) return 'Erro';
  if (t.includes('manut')) return 'Manutenção';
  return String(c).trim();
}
function normPrio(p) {
  if (!p) return null;
  const t = String(p).trim().toLowerCase();
  if (t.includes('urgente')) return 'Urgente';
  if (t.includes('alta')) return 'Alta';
  if (t.includes('m')&&t.includes('dia')) return 'Média';
  if (t.includes('baixa')) return 'Baixa';
  return String(p).trim();
}

// ─── INIT ───
function init(raw) {
  SHEETS = {};
  for (const [k,rows] of Object.entries(raw)) SHEETS[k] = rows;
}
init(RAW);

