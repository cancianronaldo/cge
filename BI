// ─── FILE UPLOAD ───
function loadFile(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(ev) {
    try {
      const wb = XLSX.read(ev.target.result, {type:'array',cellDates:true});
      const nd = {};
      wb.SheetNames.forEach(n => {
        const ws = wb.Sheets[n];
        nd[n] = XLSX.utils.sheet_to_json(ws,{defval:''}).map(r => {
          const o = {};
          for (const [k,v] of Object.entries(r))
            o[k] = v instanceof Date ? v.toISOString().slice(0,10) : v;
          return o;
        });
      });
      init(nd);
      current = 'Geral';
      renderTabs();
      renderDash();
      toast('Planilha carregada com sucesso!', false);
    } catch(err) {
      toast('Erro: ' + err.message, true);
    }
  };
  reader.readAsArrayBuffer(file);
}

// ─── TOAST ───
function toast(msg, err) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.background = err ? 'var(--red)' : 'var(--green)';
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3500);
}

// ─── HELPERS ───
function rows(sheet) {
  if (sheet === 'Geral') {
    let all = [];
    for (const [k,rs] of Object.entries(SHEETS)) rs.forEach(r => all.push({...r,_s:k}));
    return all;
  }
  return (SHEETS[sheet]||[]).map(r=>{return{...r,_s:sheet}});
}
function isFala(r) { return r._s === 'FALA-SP' || 'Titulo ' in r || 'Titulo' in r }
function gs(r) { return normStatus(r.Status||r.status||'') }
function gc(r) { return normCat(r.Categoria||'') }
function gp(r) { return normPrio(r.Prioridade||'') }

function countMap(arr) {
  const m = {};
  arr.forEach(x => { if(x) m[x]=(m[x]||0)+1 });
  return m;
}

function getImp(rs) {
  return rs.filter(r => {
    const imp = r['Data de Impedimento'];
    return (imp && imp !== '' && imp !== 'NaT') || gs(r) === 'Impedimento';
  });
}

function getConcl(rs) {
  return rs.filter(r => {
    const s = gs(r).toLowerCase();
    return s.includes('produ') || s.includes('encerra') || s.includes('conclu');
  });
}

function getTimeline(rs) {
  const m = {};
  rs.filter(r=>!isFala(r)).forEach(r => {
    const pp = r['Previsão Produção'];
    if (!pp||pp==='') return;
    const d = String(pp).slice(0,7);
    if (/^\d{4}-\d{2}$/.test(d)) m[d]=(m[d]||0)+1;
  });
  return m;
}

// ─── BADGE CLASS ───
function bc(status) {
  const s = status.toLowerCase();
  if (s.includes('produ')) return 'b-prod';
  if (s.includes('backlog')||s.includes('aberto')) return 'b-back';
  if (s.includes('impedi')||s.includes('impedit')) return 'b-imp';
  if (s.includes('homolog')) return 'b-hom';
  if (s.includes('encerra')||s.includes('conclu')) return 'b-enc';
  if (s.includes('desenv')) return 'b-dev';
  if (s.includes('open')) return 'b-open';
  return 'b-back';
}

// ─── CHARTS ───
let charts = {};
function killCharts() {
  for (const c of Object.values(charts)) try{c.destroy()}catch(e){}
  charts = {};
}

const COLORS = ['#1847c4','#146c3a','#a05c0a','#b01818','#5b2ca0','#0a6a62','#6b3a12','#2a5c8a'];
const COLORS_LIGHT = ['rgba(24,71,196,.15)','rgba(20,108,58,.15)','rgba(160,92,10,.15)','rgba(176,24,24,.15)','rgba(91,44,160,.15)','rgba(10,106,98,.15)'];

// ─── TABS ───
function renderTabs() {
  const tabs = ['Geral', ...Object.keys(SHEETS)];
  document.getElementById('tabs').innerHTML = tabs.map(t =>
    `<div class="tab ${t===current?'on':''}" onclick="selectTab('${t}')">${t}</div>`
  ).join('');
}

function selectTab(name) {
  current = name;
  renderTabs();
  renderDash();
}

// ─── DASHBOARD ───
function renderDash() {
  killCharts();
  const rs = rows(current);
  const structured = rs.filter(r => !isFala(r));
  const all = rs;
  const isFalaTab = current === 'FALA-SP';

  const total = all.length;
  const imp = getImp(all);
  const concl = getConcl(all);
  const pct = total ? Math.round(concl.length/total*100) : 0;
  const statusMap = countMap(all.map(r => gs(r)));
  const catMap = countMap(structured.map(r => gc(r)).filter(Boolean));
  const prioMap = countMap(structured.map(r => gp(r)).filter(Boolean));
  const prioHigh = (prioMap['Urgente']||0)+(prioMap['Alta']||0);
  const timeline = getTimeline(all);

  const tableRS = isFalaTab ? all : structured;

  let html = '';

  // FALA notice
  if (isFalaTab) {
    html += `<div class="fala-notice">ℹ️ A aba <strong>FALA-SP</strong> possui estrutura simplificada (Título, Card, Status). Os gráficos de categoria, prioridade e timeline utilizam dados das demais abas.</div>`;
  }

  // KPIs
  html += `<div class="slabel">Visão Geral</div>
  <div class="kpis">
    <div class="kpi k-blue"><div class="kpi-label">Total de Demandas</div><div class="kpi-value">${total}</div><div class="kpi-sub">todas as solicitações</div></div>
    <div class="kpi k-green"><div class="kpi-label">Em Produção / Concluído</div><div class="kpi-value">${concl.length}</div><div class="kpi-sub">${pct}% do total</div></div>
    <div class="kpi k-red"><div class="kpi-label">Com Impedimento</div><div class="kpi-value">${imp.length}</div><div class="kpi-sub">itens bloqueados</div></div>
    <div class="kpi k-amber"><div class="kpi-label">Alta Prioridade</div><div class="kpi-value">${prioHigh}</div><div class="kpi-sub">Urgente + Alta</div></div>
    <div class="kpi k-purple"><div class="kpi-label">Tipos de Status</div><div class="kpi-value">${Object.keys(statusMap).length}</div><div class="kpi-sub">status distintos</div></div>
  </div>`;

  // Progress
  html += `<div class="prog-card">
    <div class="prog-head">
      <div class="prog-title">Progresso do Projeto — Demandas Concluídas</div>
      <div class="prog-pct">${pct}%</div>
    </div>
    <div class="prog-track"><div class="prog-fill" id="pfill" style="width:0%"></div></div>
    <div class="prog-legend">
      <span><span class="prog-dot" style="background:var(--green)"></span>Produção/Concluído: ${concl.length}</span>
      <span><span class="prog-dot" style="background:var(--border2)"></span>Em andamento: ${total-concl.length}</span>
      <span><span class="prog-dot" style="background:var(--red)"></span>Impedimentos: ${imp.length}</span>
    </div>
  </div>`;

  // Status chips
  html += `<div class="slabel">Distribuição por Status</div><div class="status-chips">`;
  for (const [s,c] of Object.entries(statusMap).sort((a,b)=>b[1]-a[1])) {
    html += `<div class="s-chip"><span class="s-chip-n">${c}</span><span class="s-chip-l">${s}</span></div>`;
  }
  html += `</div>`;

  // Charts row 1
  html += `<div class="slabel">Análises</div><div class="charts-grid">
    <div class="chart-card">
      <div class="chart-title">Status — Distribuição</div>
      <div class="chart-wrap" style="height:230px"><canvas id="cStatus" role="img" aria-label="Rosca de status"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Mix de Categorias</div>
      <div class="chart-wrap" style="height:230px"><canvas id="cCat" role="img" aria-label="Pizza de categorias"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Priorização Global</div>
      <div class="chart-wrap" style="height:230px"><canvas id="cPrio" role="img" aria-label="Barras de prioridade"></canvas></div>
    </div>
  </div>`;

  // Timeline
  html += `<div class="slabel">Timeline de Entregas</div>
  <div class="timeline-card">
    <div class="chart-title">Previsão de Produção por Mês (volume de itens)</div>
    <div class="chart-wrap" style="height:200px"><canvas id="cTimeline" role="img" aria-label="Timeline de entregas"></canvas></div>
  </div>`;

  // Impedimentos
  if (imp.length > 0) {
    html += `<div class="imp-block"><div class="imp-title">⚠ Itens com Impedimento (${imp.length})</div>`;
    imp.slice(0,12).forEach(r => {
      const desc = r['Descrição']||r['Titulo ']||r['Titulo']||'Sem descrição';
      const obs = r['Observação']||'';
      html += `<div class="imp-item"><strong>${String(r._s||'').slice(0,12)}</strong> · ${String(desc).slice(0,80)}${obs?' — '+String(obs).slice(0,60):''}</div>`;
    });
    if (imp.length>12) html += `<div class="imp-item" style="opacity:.6">... e mais ${imp.length-12} itens</div>`;
    html += `</div>`;
  }

  // Table
  html += `<div class="slabel">Lista Detalhada de Entregas</div>
  <div class="table-card">
    <div class="table-head">
      <span class="table-head-title">${tableRS.length} registros</span>
      <div class="table-controls">
        <input class="search-box" type="search" placeholder="Buscar na tabela..." oninput="filterTable(this.value)" id="srch">
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr>
          ${current==='Geral'?'<th>Sistema</th>':''}
          <th>Código</th><th style="min-width:220px">Descrição</th>
          <th>Categoria</th><th>Status</th><th>Prioridade</th><th>Previsão Produção</th>
        </tr></thead>
        <tbody id="tbody">`;

  tableRS.forEach(r => {
    const cod = r['Código']||r['Card']||'—';
    const desc = r['Descrição']||r['Titulo ']||r['Titulo']||'';
    const cat = gc(r)||'';
    const status = gs(r);
    const prio = gp(r)||'';
    const prev = String(r['Previsão Produção']||'').slice(0,10);
    html += `<tr>
      ${current==='Geral'?`<td class="mono" style="font-size:10px">${r._s}</td>`:''}
      <td class="mono">${String(cod).slice(0,20)}</td>
      <td style="max-width:280px;font-size:12px">${String(desc).slice(0,90)}${desc.length>90?'…':''}</td>
      <td>${cat?`<span class="badge b-back">${cat}</span>`:''}</td>
      <td><span class="badge ${bc(status)}">${status}</span></td>
      <td style="font-size:11px;color:var(--ink2)">${prio}</td>
      <td class="mono" style="font-size:11px">${prev}</td>
    </tr>`;
  });

  html += `</tbody></table></div></div>`;

  document.getElementById('main').innerHTML = html;

  // Animate progress bar
  setTimeout(() => {
    const pf = document.getElementById('pfill');
    if (pf) pf.style.width = pct + '%';
  }, 100);

  // Draw charts
  const isDark = matchMedia('(prefers-color-scheme:dark)').matches;
  const gridColor = isDark ? 'rgba(255,255,255,.07)' : 'rgba(0,0,0,.06)';
  const tickColor = isDark ? 'rgba(255,255,255,.4)' : 'rgba(0,0,0,.4)';

  setTimeout(() => {
    // Status donut
    const sLabels = Object.keys(statusMap);
    const sVals = Object.values(statusMap);
    charts.s = new Chart(document.getElementById('cStatus'), {
      type:'doughnut',
      data:{labels:sLabels,datasets:[{data:sVals,backgroundColor:COLORS.slice(0,sLabels.length),borderWidth:2,borderColor:isDark?'#1c1c14':'#fff'}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{font:{size:10},padding:8,color:isDark?'#a8a69e':'#5c5a52'}}}}
    });

    // Category pie
    const cLabels = Object.keys(catMap);
    const cVals = Object.values(catMap);
    charts.c = new Chart(document.getElementById('cCat'), {
      type:'pie',
      data:{labels:cLabels.length?cLabels:['Sem cat'],datasets:[{data:cVals.length?cVals:[1],backgroundColor:COLORS.slice(0,Math.max(cLabels.length,1)),borderWidth:2,borderColor:isDark?'#1c1c14':'#fff'}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{font:{size:10},padding:8,color:isDark?'#a8a69e':'#5c5a52'}}}}
    });

    // Priority bars
    const pOrder = ['Urgente','Alta','Média','Baixa'];
    const pLabels = pOrder.filter(p=>prioMap[p]);
    const pVals = pLabels.map(p=>prioMap[p]||0);
    const pColors = ['#b01818','#a05c0a','#1847c4','#146c3a'];
    charts.p = new Chart(document.getElementById('cPrio'), {
      type:'bar',
      data:{labels:pLabels.length?pLabels:['—'],datasets:[{label:'Demandas',data:pVals.length?pVals:[0],backgroundColor:pColors.slice(0,pLabels.length||1),borderRadius:5,borderSkipped:false}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{stepSize:1,color:tickColor},grid:{color:gridColor}},x:{ticks:{color:tickColor},grid:{display:false}}}}
    });

    // Timeline
    const tlK = Object.keys(timeline).sort();
    const tlV = tlK.map(k=>timeline[k]);
    charts.t = new Chart(document.getElementById('cTimeline'), {
      type:'bar',
      data:{labels:tlK.length?tlK:['Sem dados'],datasets:[{label:'Itens',data:tlV.length?tlV:[0],backgroundColor:'#1847c4',borderRadius:4,borderSkipped:false}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},
        scales:{x:{ticks:{autoSkip:false,maxRotation:45,font:{size:9},color:tickColor},grid:{display:false}},y:{beginAtZero:true,ticks:{stepSize:1,color:tickColor},grid:{color:gridColor}}}}
    });
  }, 60);
}

window.filterTable = function(term) {
  const t = term.toLowerCase();
  document.querySelectorAll('#tbody tr').forEach(r => {
    r.style.display = r.textContent.toLowerCase().includes(t) ? '' : 'none';
  });
};

// ─── START ───
renderTabs();
renderDash();
</script>
</body>
</html>
